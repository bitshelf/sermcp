__pycache__/

*.pyc
# One lock for the whole workspace, checked in at the root: it is what every
# `--locked` build resolves against, members included.
*Cargo.lock
!/Cargo.lock

/.claude/
/.dut-serial/
/.dut-serial/pi-mcp-client.log
/.target.jsonc

/bin/
/dist/

/target/

/sermcp/.dut-serial/
# pre-workspace build directory; the workspace now builds into /target/
/sermcp/target/

/node_modules/
/package-lock.json

/.pytest_cache/
/.semcode.db/

/.venv/
.env

uv.lock

# plugin pack artifacts (install via github link, never commit stale tarballs)
dsh-plugins/*.tgz
dsh-plugins/**/*.tgz

# cargo-mutants run artifacts (regenerated by `cargo mutants`; .old is the
# previous run's automatic rotation backup)
sermcp/mutants.out/
sermcp/mutants.out.old/
