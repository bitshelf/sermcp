{
  "name": "dsh-dut-statusline",
  "version": "0.3.0",
  "description": "Show sermcp DUT serial states (active/crashed/disconnected…) on the dsh-tui statusline via the tuiStatus seam — no TUI patch, version-independent",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4"
  }
}
